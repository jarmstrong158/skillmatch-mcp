# Local data is never committed (profile, applications.db, scouted/ranked jobs,
# email_config.json with real Gmail credentials, screenshots, etc.).
# Only the folder placeholder and the credential template are tracked.
data/*
!data/.gitkeep
!data/email_config.example.json
__pycache__/
*.pyc
.mcp.json
.mcpregistry_*
dist/
.cambium/
.context/
